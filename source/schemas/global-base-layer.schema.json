{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jounirautio78-ops.github.io/pixan-global-market-evidence-public/schemas/global-base-layer.schema.json",
  "title": "Pixan global base layer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "meta",
    "sources",
    "summary",
    "methodRouteControl",
    "countries",
    "globalRetailSales"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "methodRouteControl": {
      "$ref": "#/$defs/methodRouteControl"
    },
    "countries": {
      "type": "array",
      "minItems": 195,
      "maxItems": 195,
      "items": {
        "$ref": "#/$defs/country"
      }
    },
    "globalRetailSales": {
      "$ref": "#/$defs/globalRetailSales"
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe",
        "countryCount",
        "observationCount",
        "generatedAt",
        "snapshotWindow",
        "selectionRuleEn",
        "selectionRuleFi",
        "publicationClass"
      ],
      "properties": {
        "universe": {
          "const": "UN193+VA+PS"
        },
        "countryCount": {
          "const": 195
        },
        "observationCount": {
          "const": 975
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "snapshotWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startYear",
            "endYear",
            "selection"
          ],
          "properties": {
            "startYear": {
              "const": 2020
            },
            "endYear": {
              "const": 2024
            },
            "selection": {
              "const": "latest_non_null"
            }
          }
        },
        "selectionRuleEn": {
          "type": "string",
          "minLength": 1
        },
        "selectionRuleFi": {
          "type": "string",
          "minLength": 1
        },
        "publicationClass": {
          "const": "official_open_derived_snapshot"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "publisher",
        "dataset",
        "landingUrl",
        "apiDocumentationUrl",
        "licenseUrl",
        "publicationPolicy"
      ],
      "properties": {
        "sourceId": {
          "enum": [
            "WB-WDI",
            "WHO-GHO",
            "UN-COMTRADE"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "landingUrl": {
          "type": "string",
          "format": "uri"
        },
        "apiDocumentationUrl": {
          "type": "string",
          "format": "uri"
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri"
        },
        "publicationPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedCount",
        "missingCount",
        "queuedCount",
        "measures",
        "gdpEurEquivalent"
      ],
      "properties": {
        "observedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 975
        },
        "missingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 975
        },
        "queuedCount": {
          "const": 390
        },
        "measures": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/measureSummary"
          }
        },
        "gdpEurEquivalent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "computedCount",
            "notComputedCount",
            "periodRule"
          ],
          "properties": {
            "computedCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 195
            },
            "notComputedCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 195
            },
            "periodRule": {
              "const": "same_source_year_only"
            }
          }
        }
      }
    },
    "measureSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measureId",
        "sourceId",
        "observedCount",
        "missingCount",
        "queuedCount",
        "sourcePeriods",
        "retailSalesEligible"
      ],
      "properties": {
        "measureId": {
          "enum": [
            "population_total",
            "population_ages_15_64",
            "gdp_per_capita_current_usd",
            "who_adult_current_ecig_prevalence",
            "un_comtrade_vaping_trade"
          ]
        },
        "sourceId": {
          "enum": [
            "WB-WDI",
            "WHO-GHO",
            "UN-COMTRADE"
          ]
        },
        "observedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 195
        },
        "missingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 195
        },
        "queuedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 195
        },
        "sourcePeriods": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourcePeriod",
              "count"
            ],
            "properties": {
              "sourcePeriod": {
                "type": "integer",
                "minimum": 2020,
                "maximum": 2024
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 195
              }
            }
          }
        },
        "retailSalesEligible": {
          "const": false
        }
      }
    },
    "worldBankObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measureId",
        "sourceId",
        "sourceSeries",
        "sourcePeriod",
        "value",
        "unit",
        "currency",
        "dataStatus",
        "acquisitionStatus",
        "missingReason",
        "retailSalesEligible",
        "sourceUrl"
      ],
      "properties": {
        "measureId": {
          "enum": [
            "population_total",
            "population_ages_15_64"
          ]
        },
        "sourceId": {
          "const": "WB-WDI"
        },
        "sourceSeries": {
          "type": "string",
          "minLength": 1
        },
        "sourcePeriod": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2020,
          "maximum": 2024
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "const": "person"
        },
        "currency": {
          "type": "null"
        },
        "dataStatus": {
          "enum": [
            "observed",
            "missing"
          ]
        },
        "acquisitionStatus": {
          "const": "validated"
        },
        "missingReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "retailSalesEligible": {
          "const": false
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "gdpObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measureId",
        "sourceId",
        "sourceSeries",
        "sourcePeriod",
        "value",
        "unit",
        "currency",
        "dataStatus",
        "acquisitionStatus",
        "missingReason",
        "retailSalesEligible",
        "sourceUrl",
        "eurEquivalent"
      ],
      "properties": {
        "measureId": {
          "const": "gdp_per_capita_current_usd"
        },
        "sourceId": {
          "const": "WB-WDI"
        },
        "sourceSeries": {
          "const": "NY.GDP.PCAP.CD"
        },
        "sourcePeriod": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2020,
          "maximum": 2024
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "const": "USD_per_person"
        },
        "currency": {
          "const": "USD"
        },
        "dataStatus": {
          "enum": [
            "observed",
            "missing"
          ]
        },
        "acquisitionStatus": {
          "const": "validated"
        },
        "missingReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "retailSalesEligible": {
          "const": false
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "eurEquivalent": {
          "$ref": "#/$defs/eurEquivalent"
        }
      }
    },
    "eurEquivalent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "sourcePeriod",
        "periodRule",
        "formula",
        "status",
        "value",
        "rateId",
        "rateYear",
        "currencyUnitsPerEur",
        "reason"
      ],
      "properties": {
        "currency": {
          "const": "EUR"
        },
        "sourcePeriod": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2020,
          "maximum": 2024
        },
        "periodRule": {
          "const": "same_source_year_only"
        },
        "formula": {
          "const": "usd_value / currency_units_per_eur"
        },
        "status": {
          "enum": [
            "computed",
            "not_computed"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rateId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rateYear": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2020,
          "maximum": 2024
        },
        "currencyUnitsPerEur": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "queuedRouteObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measureId",
        "sourceId",
        "sourceSeries",
        "sourcePeriod",
        "value",
        "unit",
        "currency",
        "dataStatus",
        "acquisitionStatus",
        "missingReason",
        "retailSalesEligible",
        "sourceUrl"
      ],
      "properties": {
        "measureId": {
          "enum": [
            "who_adult_current_ecig_prevalence",
            "un_comtrade_vaping_trade"
          ]
        },
        "sourceId": {
          "enum": [
            "WHO-GHO",
            "UN-COMTRADE"
          ]
        },
        "sourceSeries": {
          "type": "string",
          "minLength": 1
        },
        "sourcePeriod": {
          "type": "null"
        },
        "value": {
          "type": "null"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "null"
        },
        "dataStatus": {
          "const": "missing"
        },
        "acquisitionStatus": {
          "const": "queued"
        },
        "missingReason": {
          "const": "not_retrieved_in_v27"
        },
        "retailSalesEligible": {
          "const": false
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "methodRouteControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "asOf",
        "status",
        "boundaryEn",
        "boundaryFi",
        "summary",
        "methods",
        "nextActions",
        "provenanceSources"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]+$"
        },
        "asOf": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "const": "research_route_map_not_market_values"
        },
        "boundaryEn": {
          "type": "string",
          "minLength": 1
        },
        "boundaryFi": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "$ref": "#/$defs/methodRouteSummary"
        },
        "methods": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/methodDefinition"
          }
        },
        "nextActions": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/nextActionDefinition"
          }
        },
        "provenanceSources": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/provenanceSource"
          }
        }
      }
    },
    "methodRouteSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countryCount",
        "reviewedMethodPlanCount",
        "reviewedSourceLeadCount",
        "regionalTpdPatternOnlyCount",
        "proxyOnlyUnscopedCount",
        "reviewedNationalRouteOrLeadCount",
        "nonDefaultRouteCount",
        "retailValueStatusCounts",
        "eligibleForGlobalRollupCount",
        "donorAcceptedCount"
      ],
      "properties": {
        "countryCount": {
          "const": 195
        },
        "reviewedMethodPlanCount": {
          "const": 23
        },
        "reviewedSourceLeadCount": {
          "const": 5
        },
        "regionalTpdPatternOnlyCount": {
          "const": 15
        },
        "proxyOnlyUnscopedCount": {
          "const": 152
        },
        "reviewedNationalRouteOrLeadCount": {
          "const": 28
        },
        "nonDefaultRouteCount": {
          "const": 43
        },
        "retailValueStatusCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "officialPointEstimateQualityLimited",
            "observedPartialChannelOnly",
            "notComputed"
          ],
          "properties": {
            "officialPointEstimateQualityLimited": {
              "const": 1
            },
            "observedPartialChannelOnly": {
              "const": 1
            },
            "notComputed": {
              "const": 193
            }
          }
        },
        "eligibleForGlobalRollupCount": {
          "const": 0
        },
        "donorAcceptedCount": {
          "const": 0
        }
      }
    },
    "methodDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "labelEn",
        "labelFi",
        "transactionStage",
        "canEstablishRetailValueAlone",
        "boundaryEn",
        "boundaryFi"
      ],
      "properties": {
        "methodId": {
          "$ref": "#/$defs/methodId"
        },
        "labelEn": {
          "type": "string",
          "minLength": 1
        },
        "labelFi": {
          "type": "string",
          "minLength": 1
        },
        "transactionStage": {
          "type": "string",
          "minLength": 1
        },
        "canEstablishRetailValueAlone": {
          "const": false
        },
        "boundaryEn": {
          "type": "string",
          "minLength": 1
        },
        "boundaryFi": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "methodId": {
      "enum": [
        "official_retail_survey",
        "specialist_retail_annual_returns",
        "excise_plus_statutory_sales",
        "statutory_annual_sales_reporting",
        "excise_to_volume_reconstruction",
        "manufacturer_reporting_plus_pos",
        "commercial_pos_validation",
        "customs_trade_proxy",
        "production_survey_plus_customs",
        "regulated_supply_plus_enforcement",
        "marking_system_retail_plus_excise",
        "enforcement_trade_only",
        "product_registry_plus_sales_request",
        "excise_designated_retail_price",
        "eu_tpd_annual_reporting_pattern",
        "official_route_not_scoped"
      ]
    },
    "nextActionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nextActionId",
        "labelEn",
        "labelFi"
      ],
      "properties": {
        "nextActionId": {
          "$ref": "#/$defs/nextActionId"
        },
        "labelEn": {
          "type": "string",
          "minLength": 1
        },
        "labelFi": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nextActionId": {
      "enum": [
        "close_retail_d5_d7_d10",
        "close_partial_channel_tax_reconciliation",
        "reconcile_excise_sales_price_pos",
        "bridge_manufacturer_to_retail_pos",
        "reconstruct_tax_base_then_retail_bridge",
        "request_statutory_sales_aggregate",
        "registry_to_sales_aggregate",
        "production_trade_to_domestic_sellthrough",
        "classify_customs_scope_then_domestic_bridge",
        "separate_lawful_supply_enforcement_retail",
        "reproduce_marked_retail_and_illicit_boundary",
        "establish_lawful_market_scope",
        "obtain_designated_price_tax_totals",
        "validate_country_source_lead",
        "identify_national_tpd_holder_and_request_aggregate",
        "scope_country_specific_official_route"
      ]
    },
    "provenanceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basisId",
        "labelEn",
        "labelFi"
      ],
      "properties": {
        "basisId": {
          "$ref": "#/$defs/provenanceBasisId"
        },
        "labelEn": {
          "type": "string",
          "minLength": 1
        },
        "labelFi": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "provenanceBasisId": {
      "enum": [
        "UN195",
        "OPEN_BASE",
        "TOP20",
        "THIRD_DONOR",
        "MARNET_PUBLIC",
        "EU_TPD_20_7",
        "DONOR_CONTROL"
      ]
    },
    "countryMethodRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentClass",
        "reviewLevel",
        "primaryMethodId",
        "secondaryMethodIds",
        "primaryMethodLabelEn",
        "primaryMethodLabelFi",
        "transactionStage",
        "nextActionId",
        "nextActionEn",
        "nextActionFi",
        "provenanceBasisIds",
        "retailValueStatus",
        "eligibleForGlobalRollup",
        "donorAssessmentState",
        "donorAccepted",
        "requestState",
        "lastReviewedOn",
        "boundaryEn",
        "boundaryFi"
      ],
      "properties": {
        "assignmentClass": {
          "enum": [
            "reviewed_method_plan",
            "reviewed_source_lead",
            "regional_tpd_pattern_only",
            "proxy_only_unscoped"
          ]
        },
        "reviewLevel": {
          "enum": [
            "country_method_reviewed",
            "source_lead_reviewed_method_unassigned",
            "regional_pattern_reviewed_national_route_unverified",
            "country_specific_route_not_reviewed"
          ]
        },
        "primaryMethodId": {
          "$ref": "#/$defs/methodId"
        },
        "secondaryMethodIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/methodId"
          }
        },
        "primaryMethodLabelEn": {
          "type": "string",
          "minLength": 1
        },
        "primaryMethodLabelFi": {
          "type": "string",
          "minLength": 1
        },
        "transactionStage": {
          "type": "string",
          "minLength": 1
        },
        "nextActionId": {
          "$ref": "#/$defs/nextActionId"
        },
        "nextActionEn": {
          "type": "string",
          "minLength": 1
        },
        "nextActionFi": {
          "type": "string",
          "minLength": 1
        },
        "provenanceBasisIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/provenanceBasisId"
          }
        },
        "retailValueStatus": {
          "enum": [
            "official_point_estimate_quality_limited",
            "observed_partial_channel_only",
            "not_computed"
          ]
        },
        "eligibleForGlobalRollup": {
          "const": false
        },
        "donorAssessmentState": {
          "enum": [
            "assessed_not_accepted",
            "not_assessed"
          ]
        },
        "donorAccepted": {
          "const": false
        },
        "requestState": {
          "enum": [
            "sent",
            "draft_not_sent",
            "not_in_top20_program"
          ]
        },
        "lastReviewedOn": {
          "type": "string",
          "format": "date"
        },
        "boundaryEn": {
          "type": "string",
          "minLength": 1
        },
        "boundaryFi": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iso2",
        "name",
        "nameFi",
        "region",
        "worldBank",
        "routes",
        "methodRoute",
        "retailSalesEligible"
      ],
      "properties": {
        "iso2": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nameFi": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "worldBank": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "populationTotal",
            "populationAges15To64",
            "gdpPerCapitaCurrentUsd"
          ],
          "properties": {
            "populationTotal": {
              "$ref": "#/$defs/worldBankObservation"
            },
            "populationAges15To64": {
              "$ref": "#/$defs/worldBankObservation"
            },
            "gdpPerCapitaCurrentUsd": {
              "$ref": "#/$defs/gdpObservation"
            }
          }
        },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "whoAdultCurrentEcigPrevalence",
            "unComtradeVapingTrade"
          ],
          "properties": {
            "whoAdultCurrentEcigPrevalence": {
              "$ref": "#/$defs/queuedRouteObservation"
            },
            "unComtradeVapingTrade": {
